# Configuração do projeto. Senhas simples porque o projeto roda só localmente.
# Alterou algo? Rode: docker compose up -d --force-recreate

# ---------- RabbitMQ (login do painel http://localhost:15672) ----------
RABBITMQ_VHOST=ecommerce
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASS=admin123
RABBITMQ_MANAGEMENT_PORT=15672

# ---------- Um usuário do RabbitMQ para cada serviço ----------
API_PEDIDOS_RABBITMQ_USER=api_pedidos
API_PEDIDOS_RABBITMQ_PASS=api123
ESTOQUE_RABBITMQ_USER=svc_estoque
ESTOQUE_RABBITMQ_PASS=estoque123
PAGAMENTO_RABBITMQ_USER=svc_pagamento
PAGAMENTO_RABBITMQ_PASS=pagamento123
LOGISTICA_RABBITMQ_USER=svc_logistica
LOGISTICA_RABBITMQ_PASS=logistica123

# ---------- API ----------
API_PORT=8080

# ---------- Escala: quantos containers de cada serviço ----------
ESTOQUE_REPLICAS=1
PAGAMENTO_REPLICAS=1
LOGISTICA_REPLICAS=1

# ---------- Simulação de erros ----------
# % de falhas técnicas (passam pelo retry)
FALHA_PERCENTUAL=10
# % de erros fatais (vão direto para a DLQ)
FALHA_FATAL_PERCENTUAL=5
# tentativas antes de mandar para a DLQ
MAX_TENTATIVAS=3
# mensagens sem ack por container (basic.qos)
PREFETCH=10
